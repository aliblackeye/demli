# ============================================================================
# Demli PRODUCTION environment. Copy to .env.prod and fill in real values:
#
#     cp .env.prod.example .env.prod
#
# .env.prod is gitignored. NEVER commit real secrets (CLAUDE.md §18).
# Consumed by docker-compose.prod.yml and scripts/deploy.sh. Every variable
# below is either read by app code, by an infra service, or by the deploy
# tooling — the "NOT NEEDED" section at the bottom lists vars that look
# plausible but nothing reads, so no one re-adds them.
# ============================================================================

# --- Domain -----------------------------------------------------------------
# THE one public domain. Everything the product exposes lives under it: the
# landing site (apex + www), the web app (app), the API and its /dl/ release
# feed (api), the realtime gateway (ws), LiveKit signaling (livekit) and TURN
# (turn). Used by Caddy for every vhost and to build LIVEKIT_URL.
#
# Required DNS A records, ALL pointing at the VPS public IP:
#   <DOMAIN>  www  app  api  ws  livekit  turn
#
# All but `turn` get a Caddy vhost, and a vhost whose name does not resolve
# makes Caddy retry its certificate forever — so the zone and the Caddyfile host
# list must match exactly (`pnpm lint:caddy` enforces the Caddyfile side).
#
# THERE IS NO SECOND DOMAIN PLACEHOLDER. A previous revision carried a
# BRAND_DOMAIN alongside this one and duplicated every backend vhost under it;
# once both names resolved to the same value Caddy saw each site defined twice
# and refused to load the config. If a second public domain is ever wanted, add
# it as an extra address on the SAME site block in the Caddyfile.
DOMAIN=example.com

# Email for Let's Encrypt / ACME account (Caddy). Used for expiry notices.
ACME_EMAIL=you@example.com

# --- Runtime mode -----------------------------------------------------------
# MUST be "production" for a real deploy. Read by apps/api and apps/realtime to
# activate fail-fast secret checks (security-review M5): the API/realtime refuse
# to boot if LIVEKIT_API_KEY/SECRET are the dev defaults or REPLACE_WITH_*
# placeholders, if DATABASE_URL is the local dev default, or if REDIS_URL has no
# credentials. Leave unset/other only for local runs against dev defaults.
APP_ENV=production

# --- Image tag (OPTIONAL — leave unset on the production VPS) ---------------
# Which tag the api/realtime images are built and run under. Defaults to `prod`
# in both docker-compose.prod.yml and scripts/deploy.sh, so production needs no
# entry here at all.
#
# It exists so a SECOND stack on the same box can never hijack production's
# images. The images are built locally, so the tag is just a mutable name: with
# the old `:latest` the first staging build would have overwritten the very tag
# production restarts from, and the next `docker compose up` or host reboot
# would have put staging code in front of real users, silently. A staging stack
# sets IMAGE_TAG=staging (plus its own compose `name:`) and the two never touch.
#
# Precedence: an explicit `IMAGE_TAG=… bash scripts/deploy.sh` beats a value set
# here, which beats the `prod` default.
# IMAGE_TAG=prod

# --- Database: Supabase managed Postgres (NO postgres container in prod) -----
# Read by: apps/api (runtime), apps/realtime (runtime), packages/db (migrate).
#
# Use the DIRECT / session connection (host db.<ref>.supabase.co, port 5432) —
# NOT the transaction pooler (port 6543). The backend uses postgres-js with
# prepared statements, which the transaction pooler (pgBouncer transaction
# mode) does not support; runtime queries would fail. Append ?sslmode=require —
# Supabase only accepts TLS connections. This single URL serves both the app
# runtime and migrations.
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require

# --- API (Fastify) ----------------------------------------------------------
# Comma-separated allowlist of client origins for CORS. See deploy.md
# "Desktop client origin" — confirm what Origin the packaged Electron app
# sends before relying on this in production.
#
# NOTE: the first-party web origins (getdemli.com, www.getdemli.com,
# app.getdemli.com) are ALWAYS merged in from FIRST_PARTY_WEB_ORIGINS in
# apps/api/src/env.ts — they are kept in git so a new public host ships with one
# commit + deploy instead of a hand-edit here. Only add extra origins below.
CORS_ORIGIN=https://app.example.com

# Opaque session-token lifetime in hours. 168 = 7 days (security-review M2 —
# reduced from 30 days to shrink the blast radius of a leaked token). Users can
# revoke every active session via POST /auth/logout-all.
SESSION_TTL_HOURS=168

# EAS Build webhook (task #39). When set, apps/api exposes POST /hooks/eas-build
# which verifies Expo's HMAC-SHA1 signature and, on a finished Android build,
# replaces /srv/demli-dl/mobile/demli.apk (served at /dl/mobile/demli.apk)
# with the new build — no more manual curl. Leave unset to disable (route 404s).
# Generate:  openssl rand -hex 32   (min 16 chars; Expo requirement). The SAME
# value must be registered with Expo:
#   npx eas-cli webhook:create --event BUILD --url https://api.${DOMAIN}/hooks/eas-build --secret <SECRET>
# Prereq once on the VPS (api runs as uid 1000): the mounted dir must be writable
#   sudo install -d -o 1000 -g 1000 /srv/demli-dl/mobile
EAS_WEBHOOK_SECRET=REPLACE_WITH_EAS_WEBHOOK_SECRET

# Native-update advertisement served at PUBLIC GET /mobile/version. The sideloaded
# APK cannot self-update its native runtime over OTA, so on launch it compares its
# own runtimeVersion against these values and prompts a reinstall from the APK link
# above (kept fresh by the EAS webhook). The server only serves the facts; the
# semver comparison happens on the device. No secret, no migration.
#   MOBILE_LATEST_RUNTIME  Newest shipped runtimeVersion — MUST match app.json on
#                          each native release, else no one is ever prompted.
#   MOBILE_APK_URL         Stable public APK download link (Caddy /dl/mobile/…).
#   MOBILE_MIN_RUNTIME     OPTIONAL hard floor: installs older than this are force-
#                          updated (blocking screen). Leave unset for advisory-only.
#
# BOTH of the first two are PINNED in docker-compose.prod.yml, which overrides this
# file — a native release is one commit + deploy, never a hand-edit on the VPS.
# They are listed here only so the full config surface is documented in one place;
# editing them here has NO effect in production.
MOBILE_LATEST_RUNTIME=1.7.0
MOBILE_APK_URL=https://api.${DOMAIN}/dl/mobile/demli.apk
# MOBILE_MIN_RUNTIME=1.0.0

# --- LiveKit (self-hosted SFU + built-in TURN) ------------------------------
# Public wss URL the API returns to clients (proxied by Caddy). Must resolve to
# the VPS. Read by apps/api.
#
# THIS IS THE SINGLE SWITCH POINT for which LiveKit hostname every client uses:
# the API hands this value to desktop/mobile/web at join time (voice, dm-calls,
# moderation) AND derives its own LiveKit admin HTTP base from it. Changing it
# takes effect on the next call with no client rebuild — but verify the host has
# a valid certificate first (curl -fsS -I https://livekit.<DOMAIN>), because a
# bad value here breaks every voice session at once.
LIVEKIT_URL=wss://livekit.example.com

# API key/secret. The secret also signs the LiveKit media JWTs. Generate strong
# values, e.g.:   openssl rand -hex 16   (key)   /   openssl rand -hex 32   (secret)
# Read by apps/api; also assembled by compose into LIVEKIT_KEYS for the server.
LIVEKIT_API_KEY=REPLACE_WITH_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=REPLACE_WITH_LIVEKIT_API_SECRET

# TURN realm/domain — a DNS A record pointing at the VPS. deploy.sh defaults it
# to turn.<DOMAIN> when unset; set it explicitly to override.
#
# TURN HAS NO CADDY VHOST, on purpose. LiveKit takes a single `domain`
# (deploy/livekit.yaml) that is BOTH the TURN host it advertises to clients and
# the long-term-credential AUTH REALM, and TURN traffic is UDP/3478 straight off
# the host — it never passes through Caddy, so a vhost would do nothing. It does
# still need its own A record. A realm mismatch breaks relay candidates for
# precisely the users who need them (restrictive / mobile-carrier NATs) — the
# hardest failure to spot from a desk — so change this only together with the
# DNS record, and expect it to take effect at the next join (no client rebuild).
TURN_DOMAIN=turn.example.com

# --- Redis ------------------------------------------------------------------
# Redis backs realtime presence + the api↔realtime mutation fan-out bus and IS
# consumed at runtime by apps/api and apps/realtime. Production Redis requires a
# password (security-review M6): compose passes REDIS_PASSWORD to the server via
# `--requirepass` AND assembles the credentialed REDIS_URL
# (redis://:PASSWORD@redis:6379) that the app services read — so you only set
# the password here, once. Generate a strong value, e.g.: openssl rand -hex 32
REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD

# --- Supabase Storage (attachments, avatars, banners) -----------------------
# Read by apps/api at runtime. The SERVICE key is a SECRET — it bypasses RLS.
# Both buckets live in the same Supabase project as DATABASE_URL above.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_KEY

# Message attachments (photo/video/audio). Private bucket — the API signs reads.
SUPABASE_STORAGE_BUCKET=attachments

# Profile photos AND profile banners (one PUBLIC bucket; URLs are stored on the
# user row and served unsigned). LEAVE UNSET to keep both uploads OFF: the API
# then answers 503 AVATAR_UPLOADS_DISABLED / BANNER_UPLOADS_DISABLED instead of
# failing at write time.
SUPABASE_AVATAR_BUCKET=avatars

# --- Google sign-in (ADR 0010) ----------------------------------------------
# ID-token flow: the API verifies the token's audience, so only the CLIENT ID is
# needed — there is no client secret to store. Unset ⇒ POST /auth/google answers
# 503 GOOGLE_AUTH_DISABLED and the clients show the button disabled.
# GOOGLE_CLIENT_ID=YOUR_ID.apps.googleusercontent.com

# --- Media moderation seam (NSFW screening) ---------------------------------
# OFF by default and FAIL-OPEN: with MEDIA_MODERATION_MODE unset or `off`, no
# upload is ever rejected. The channel-level NSFW flag + the client age gate work
# regardless — this only controls AUTOMATIC image screening, which needs a model
# and therefore real CPU/RAM on this box (founder decision: enable it after
# moving to a stronger server). MEDIA_MODERATION_MODULE points at the module
# implementing the seam when a mode other than `off` is selected.
# MEDIA_MODERATION_MODE=off
# MEDIA_MODERATION_MODULE=

# --- Watch Party: in-app YouTube search (M20, ADR 0016) ---------------------
# OPTIONAL. Unset (the default) is a fully supported production state: the search
# endpoint answers 503 and GET /watch/capabilities reports searchEnabled:false, so
# clients show the paste-a-YouTube-link path instead of a search box that cannot
# work. Watch parties, playback and the queue are unaffected — none of them ever
# needed a key.
#
# To enable: Google Cloud project → enable "YouTube Data API v3" → create an API
# key → restrict it to that single API. Set it here; it never leaves the server.
#
# READ THIS BEFORE ENABLING: the quota is a hard daily ceiling, not a rate limit.
# Google grants 10,000 units/day per project; one search costs 100 units plus 1
# for the batched duration lookup. That is ~99 searches PER DAY for everyone on
# this deployment combined. The API enforces a 9,000-unit self-budget (10% under
# the real ceiling), a 25-searches-per-user-per-day cap, a 10-minute result cache
# and a per-session rate limit — and when any of those is reached the client falls
# back to pasting a link rather than losing the feature.
# YOUTUBE_API_KEY=REPLACE_WITH_YOUTUBE_DATA_API_KEY

# --- Client-identity gate ---------------------------------------------------
# OPTIONAL, and UNSET IS THE NORMAL STATE. Leave it commented out unless you are
# deliberately retiring every build older than the current one.
#
# What it does when armed: every HTTP request without an `x-demli-client` header
# is refused with 426 CLIENT_UPDATE_REQUIRED, and every WebSocket handshake
# without a `?client=` param is closed with 4426. Only current builds send that
# mark, so this is what finally turns off every retired build.
#
# ONLY the exact value `on` arms it. Empty, `true`, `1`, `ON `, a typo — all
# leave it disarmed. That is on purpose: this single value decides whether real
# users can reach the server at all.
#
# ALWAYS EXEMPT (so a refused client still has a way back): /health,
# /mobile/version, /hooks/*, and every CORS preflight.
#
# Rollback is server-side only and takes minutes: comment this line out again and
# re-run `bash scripts/deploy-remote.sh`. Nothing is needed on any client, which
# is why the switch lives here and is not pinned in docker-compose.prod.yml.
# CLIENT_GATE=on

# ============================================================================
# OPTIONAL — coturn escalation (see deploy.md "Hostile networks"). Only needed
# if LiveKit's built-in TURN is insufficient for a peer on a DPI/UDP-blocked
# network and you add a coturn service. Left commented by default.
# TURN_SHARED_SECRET=REPLACE_WITH_COTURN_STATIC_AUTH_SECRET
# ============================================================================

# ============================================================================
# NOT NEEDED (documented so they are not re-introduced):
#   JWT_SECRET / SESSION_SECRET  Sessions are opaque SHA-256 tokens with no
#                                signing secret. The only signing key in use is
#                                LIVEKIT_API_SECRET (media tokens).
#   PORT / HOST                  Set per-service by docker-compose.prod.yml
#                                (api=4000, realtime=4001; both bind 0.0.0.0).
#   LIVEKIT_KEYS                 Assembled by compose from the KEY/SECRET above.
#   REDIS_URL                    Assembled by compose from REDIS_PASSWORD
#                                (redis://:PASSWORD@redis:6379) for the app
#                                services — set REDIS_PASSWORD, not REDIS_URL.
# ============================================================================
