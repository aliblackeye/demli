+    private const val AUDIO_PREFS = "livekit_react_native_audio"
+    private const val KEY_HARDWARE_AUDIO_PROCESSING = "hardware_audio_processing"
+
+    /**
+     * Demli patch: whether the live ADM was built with the platform (hardware)
+     * echo canceller / noise suppressor. False means WebRTC's own software
+     * AEC/NS run in the audio processing module instead.
+     */
+    @JvmStatic
+    var hardwareAudioProcessingActive: Boolean = false
+        private set
+
+    /**
+     * Demli patch: the persisted choice read by [setupAdm]. The ADM is built once
+     * per React instance, so a change applies on the next app start.
+     */
+    @JvmStatic
+    fun isHardwareAudioProcessingPreferred(context: Context): Boolean =
+        context.applicationContext
+            .getSharedPreferences(AUDIO_PREFS, Context.MODE_PRIVATE)
+            .getBoolean(KEY_HARDWARE_AUDIO_PROCESSING, true)
+
+    @JvmStatic
+    fun setHardwareAudioProcessingPreferred(context: Context, preferred: Boolean) {
+        context.applicationContext
+            .getSharedPreferences(AUDIO_PREFS, Context.MODE_PRIVATE)
+            .edit()
+            .putBoolean(KEY_HARDWARE_AUDIO_PROCESSING, preferred)
+            .commit()
+    }
+
     private fun setupAdm(context: Context) {
-        val useHardwareAudioProcessing = Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q
+        val useHardwareAudioProcessing = Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q &&
+            isHardwareAudioProcessingPreferred(context)
+        hardwareAudioProcessingActive = useHardwareAudioProcessing
+        android.util.Log.i(
+            "LiveKitReactNative",
+            "setupAdm: hardwareAudioProcessing=$useHardwareAudioProcessing sdk=${Build.VERSION.SDK_INT}"
+        )
 
         adm = JavaAudioDeviceModule.builder(context)
             .setUseHardwareAcousticEchoCanceler(useHardwareAudioProcessing)
