# Demli landing page — build-time env (Vite inlines VITE_* into the bundle).
# Copy to `.env` only if you need to override; every var below already defaults
# to the production value in src/env.ts, so an unconfigured build is correct.

# Where the "Open Demli" buttons point — the web client.
VITE_APP_URL=https://app.getdemli.com

# Windows installer endpoint. Devops owns the redirect from this stable URL to
# the current file in the electron-updater feed
# (https://api.getdemli.com/dl/desktop/, exact filename in latest.yml).
VITE_DOWNLOAD_WINDOWS_URL=https://getdemli.com/download/windows

# Android APK endpoint. Devops owns the redirect to the fixed EAS APK link.
VITE_DOWNLOAD_ANDROID_URL=https://getdemli.com/download/android

# Public source repository. EMPTY BY DEFAULT: the repo is still private, and the
# landing page hides the whole open-source row when this is blank rather than
# shipping a dead link. Set it the day the repo goes public.
VITE_GITHUB_URL=
