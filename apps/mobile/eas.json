{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getdemli.com",
        "EXPO_PUBLIC_REALTIME_URL": "wss://ws.getdemli.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getdemli.com",
        "EXPO_PUBLIC_REALTIME_URL": "wss://ws.getdemli.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.getdemli.com",
        "EXPO_PUBLIC_REALTIME_URL": "wss://ws.getdemli.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
