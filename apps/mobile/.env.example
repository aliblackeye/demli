# Demli mobile — server endpoints (build-time defaults).
#
# The shipped APK bakes these at build time via eas.json (the live backend:
# https://api.getdemli.com / wss://ws.getdemli.com). There is NO in-app
# server-config screen — a normal user never touches this. These values matter
# only for a local `expo start` run against your own machine.
#
# A phone CANNOT reach the host's "localhost" — point these at an address the
# device can route to. If neither is set, the app falls back to the LIVE backend
# (see src/lib/server-config.ts), so a bare `expo start` works out of the box.
#
# --- Local development against your dev machine on the same Wi-Fi (LAN) ---
# Find your machine's LAN IP (Windows: `ipconfig` -> IPv4 Address, e.g. 192.168.1.42)
# and make sure apps/api + apps/realtime bind 0.0.0.0 (they do) and the firewall
# allows the ports. Then set:
#   EXPO_PUBLIC_API_URL=http://192.168.1.42:4000
#   EXPO_PUBLIC_REALTIME_URL=ws://192.168.1.42:4001
#
# --- Deployed backend ---
#   EXPO_PUBLIC_API_URL=https://api.getdemli.com
#   EXPO_PUBLIC_REALTIME_URL=wss://ws.getdemli.com
#
# Copy this file to `.env` and edit for a local run.

EXPO_PUBLIC_API_URL=http://192.168.1.100:4000
EXPO_PUBLIC_REALTIME_URL=ws://192.168.1.100:4001

# "Continue with Google" button (M15). Default false: renders as a disabled
# placeholder ("yakında"). Set true only once real OAuth is wired
# (server needs GOOGLE_CLIENT_ID — see apps/api/.env.example).
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
