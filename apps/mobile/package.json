{
  "name": "@demli/mobile",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Demli mobile app (React Native + Expo, Android-first)",
  "main": "expo-router/entry",
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "expo-pip",
          "@supersami/rn-foreground-service"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "start:go": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "export:android": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@livekit/react-native": "^2.11.1",
    "@livekit/react-native-expo-plugin": "^1.0.2",
    "@livekit/react-native-webrtc": "^144.1.1",
    "@supersami/rn-foreground-service": "^2.2.5",
    "@tanstack/react-query": "^5.62.0",
    "@demli/client-core": "workspace:*",
    "@demli/config": "workspace:*",
    "@demli/i18n": "workspace:*",
    "@demli/media": "workspace:*",
    "@demli/protocol": "workspace:*",
    "@demli/types": "workspace:*",
    "expo": "^57.0.0",
    "expo-audio": "~57.0.0",
    "expo-build-properties": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.0",
    "expo-document-picker": "~57.0.0",
    "expo-file-system": "~57.0.0",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.0",
    "expo-image-manipulator": "~57.0.2",
    "expo-image-picker": "~57.0.2",
    "expo-intent-launcher": "~57.0.0",
    "expo-linking": "~57.0.1",
    "expo-notifications": "~57.0.5",
    "expo-pip": "2.1.0",
    "expo-router": "~57.0.3",
    "expo-secure-store": "~57.0.0",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.0",
    "expo-system-ui": "~57.0.0",
    "expo-updates": "~57.0.6",
    "expo-video": "~57.0.0",
    "intl-pluralrules": "^2.0.1",
    "livekit-client": "^2.20.0",
    "lucide-react-native": "^1.23.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@config-plugins/react-native-webrtc": "^15.0.1",
    "@types/react": "18.3.31",
    "babel-preset-expo": "^57.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
