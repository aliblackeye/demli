# Demli web — build-time env (Vite inlines VITE_* at build).
# All three default to the production hosts, so an unconfigured build still
# targets the live backend. Override for local dev against a laptop server.

VITE_API_URL=https://api.getdemli.com
VITE_REALTIME_URL=wss://ws.getdemli.com
VITE_LIVEKIT_URL=wss://livekit.getdemli.com

# Optional: surfaced in appInfo.version (session labels, diagnostics).
VITE_APP_VERSION=0.0.1

# "Continue with Google" button (M15) — web shares the desktop renderer, so the
# same flag applies. Default false = disabled placeholder ("yakında").
VITE_GOOGLE_AUTH_ENABLED=false

# Download links (rail "download the app" dialog + the web download pill). All
# OPTIONAL and all must be https:// — the Electron external-link handler only
# opens https, so anything else is ignored and the baked default is used.
# Windows/Android default to the getdemli.com redirects; setting a URL for a
# platform also flips it from "soon" to a live button (see
# apps/desktop/src/renderer/src/lib/download-links.ts).
#   VITE_DOWNLOAD_URL_WINDOWS=https://getdemli.com/download/windows
#   VITE_DOWNLOAD_URL_ANDROID=https://getdemli.com/download/android
#   VITE_DOWNLOAD_URL_MACOS=      # set once a macOS build is actually published
#   VITE_DOWNLOAD_URL_LINUX=      # no build, no plan — leave empty
#   VITE_DOWNLOAD_URL_IOS=        # no build, no plan — leave empty
