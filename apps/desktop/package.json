{
  "name": "@demli/desktop",
  "version": "0.0.84",
  "license": "AGPL-3.0-only",
  "private": true,
  "description": "Demli desktop app (Electron + React)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "build:process-audio": "node scripts/build-process-audio.mjs",
    "verify:process-audio": "node scripts/verify-process-audio.mjs --electron",
    "package:win": "node scripts/package.mjs --win",
    "package:mac": "node scripts/package.mjs --mac"
  },
  "//": "No prod `dependencies` on purpose: electron-vite bundles EVERYTHING (main, preload, renderer) into out/, so the packaged app ships no node_modules (see electron-builder.yml `files`). electron-builder packs prod dependencies into the asar — adding one here will ship it. Only do that for a dep that truly cannot be bundled (native module), and externalize it in electron.vite.config.ts at the same time.",
  "devDependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@sapphi-red/web-noise-suppressor": "^0.3.5",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-virtual": "^3.14.5",
    "@demli/app-ui": "workspace:*",
    "@demli/client-core": "workspace:*",
    "@demli/config": "workspace:*",
    "@demli/i18n": "workspace:*",
    "@demli/media": "workspace:*",
    "@demli/protocol": "workspace:*",
    "@demli/types": "workspace:*",
    "@demli/ui": "workspace:*",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "cmdk": "^1.1.1",
    "jsdom": "^25",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "electron-updater": "^6.3.9",
    "electron-vite": "^2.3.0",
    "emoji-mart": "^5.6.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^1.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.9",
    "zod": "^3.23.8",
    "zustand": "^5.0.14"
  }
}
