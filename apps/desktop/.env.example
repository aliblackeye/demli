VITE_API_URL=http://localhost:4000
VITE_REALTIME_URL=ws://localhost:4001
VITE_LIVEKIT_URL=ws://localhost:7880

# Download links (rail "download the app" dialog). All OPTIONAL and all must be
# https:// — the main process' external-link handler only opens https, so any
# other scheme is ignored and the baked default wins. Windows/Android default to
# the getdemli.com redirects; setting a URL for a platform also flips it from
# "soon" to a live button. Matrix + rationale:
# apps/desktop/src/renderer/src/lib/download-links.ts
#   VITE_DOWNLOAD_URL_WINDOWS=https://getdemli.com/download/windows
#   VITE_DOWNLOAD_URL_ANDROID=https://getdemli.com/download/android
#   VITE_DOWNLOAD_URL_MACOS=      # set once a macOS build is actually published
#   VITE_DOWNLOAD_URL_LINUX=      # no build, no plan — leave empty
#   VITE_DOWNLOAD_URL_IOS=        # no build, no plan — leave empty

# "Continue with Google" button (M15). Default false: the button renders disabled
# ("yakında") as a placeholder. Set true only once the founder wires real OAuth
# (server needs GOOGLE_CLIENT_ID — see apps/api/.env.example).
VITE_GOOGLE_AUTH_ENABLED=false

# Sentry error monitoring. BUILD-TIME variable: it is baked into the MAIN bundle
# (main/index.ts reads it as __SENTRY_DSN__ — a packaged app has no env of its
# own). The renderer needs no DSN: renderer errors already travel to main over
# the crash IPC bridge and main forwards them, so the DSN never enters renderer
# JS and the renderer CSP needs no Sentry origin.
#
# EMPTY = FULLY DISABLED (the default): no init, no state, not one network
# request. Paste a DSN only when the founder has created the Sentry project.
# `VITE_SENTRY_DSN` is accepted as an alias so either name works.
#   SENTRY_DSN=https://<publicKey>@o000000.ingest.de.sentry.io/0000000
# Privacy posture + what is/ isn't sent: docs/architecture/crash-reporting.md
SENTRY_DSN=
