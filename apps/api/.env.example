PORT=4000
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demli
REDIS_URL=redis://localhost:6379

# Comma-separated allowlist of renderer origins (electron-vite dev server).
CORS_ORIGIN=http://localhost:5173

# Opaque session token lifetime.
SESSION_TTL_HOURS=720

# Google OAuth (0010) — "Sign in with Google". Comma-separated list of accepted
# ID-token audiences (OAuth client IDs), so the web + Android + iOS clients can
# all be trusted at once, e.g.:
#   GOOGLE_CLIENT_ID=1234-web.apps.googleusercontent.com,5678-android.apps.googleusercontent.com
# Leave empty to disable Google sign-in (POST /auth/google → 501). A client id
# is public, not a secret.
GOOGLE_CLIENT_ID=

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# Media attachments (ADR 0008) — Supabase Storage, private bucket + signed
# URLs. The service key lives ONLY here (server-side); never ship it to a
# client. Leave empty in dev to disable attachments.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_change-me
SUPABASE_STORAGE_BUCKET=attachments

# Avatar + banner uploads (profile photos/banners) — a SEPARATE, PUBLIC Supabase
# bucket, reusing SUPABASE_URL + SUPABASE_SERVICE_KEY above. OFF BY DEFAULT: leave
# empty and POST /users/me/avatar and /users/me/banner answer 503
# (AVATAR_UPLOADS_DISABLED / BANNER_UPLOADS_DISABLED). To enable, create a PUBLIC
# bucket in Supabase and set its name here.
SUPABASE_AVATAR_BUCKET=
# Media moderation (NSFW seam, M15). Single on/off switch. off (default) = the
# seam is a no-op and ALL image uploads pass (fail-open); nothing is ever rejected
# for NSFW. Set to "on" (or a future model name) to turn it on — it then
# dynamically import()s MEDIA_MODERATION_MODULE. No ML model is bundled; flipping
# this env is the entire cost of enabling/disabling moderation.
MEDIA_MODERATION_MODE=off
# Runtime module specifier the seam import()s when MEDIA_MODERATION_MODE is on.
# Exposes moderateImage(input) => { nsfw, score? }. Empty while on = still
# fail-open (nothing to call). Legacy AVATAR_MODERATION_MODULE is still read as a
# fallback for this value.
MEDIA_MODERATION_MODULE=
AVATAR_MODERATION_MODULE=

# In-app YouTube search for Watch Party (M20, ADR 0016). OPTIONAL, and leaving it
# EMPTY is a fully supported state: GET /watch/capabilities then answers
# { searchEnabled: false } and the client offers the paste-a-YouTube-link path
# instead of a search box. Watch parties themselves never needed a key — playback
# uses the free public embed.
#
# To enable: create a Google Cloud project, enable "YouTube Data API v3", make an
# API key, and (strongly recommended) restrict it to that one API. The key stays
# SERVER-SIDE — it is never sent to a client, because it spends OUR quota.
#
# Quota is the real constraint: Google grants 10,000 units/day per project and a
# search costs 100 (+1 for the batched duration lookup), i.e. ~99 searches per DAY
# for the whole deployment. The server enforces its own budget below that ceiling
# and a per-user daily cap, and caches identical queries for 10 minutes.
YOUTUBE_API_KEY=

# EAS Build webhook (task #39) — auto-refreshes the fixed public APK on every
# finished Android build. Leave EAS_WEBHOOK_SECRET empty in dev to disable the
# webhook (the /hooks/eas-build route is then not registered → 404). To enable,
# generate a secret (min 16 chars; Expo requirement) and register it with Expo:
#   openssl rand -hex 32
#   npx eas-cli webhook:create --event BUILD --url https://<host>/hooks/eas-build --secret <SECRET>
# The SAME value must be set here and passed to webhook:create.
EAS_WEBHOOK_SECRET=
# Directory the refreshed demli.apk is written to. In prod this is a mounted
# host dir (see docker-compose.prod.yml); locally leave the default unless testing.
APK_OUTPUT_DIR=/data/dl-mobile
# SSRF allowlist prefix for artifact downloads (only override if Expo changes it).
EAS_ARTIFACT_URL_PREFIX=https://expo.dev/artifacts/

APP_ENV=development
