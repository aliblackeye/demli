{
  "name": "@demli/api",
  "version": "0.0.1",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Demli HTTP API (Fastify)",
  "exports": {
    "./app": "./src/app.ts",
    "./env": "./src/env.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@demli/config": "workspace:*",
    "@demli/db": "workspace:*",
    "@demli/games": "workspace:*",
    "@demli/notifications": "workspace:*",
    "@demli/protocol": "workspace:*",
    "@demli/types": "workspace:*",
    "@demli/unfurl": "workspace:*",
    "argon2": "^0.41.1",
    "expo-server-sdk": "^6.1.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^10.9.0",
    "livekit-server-sdk": "^2.16.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
