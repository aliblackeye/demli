DATABASE_URL=postgresql://postgres:postgres@localhost:5432/demli
REDIS_URL=redis://localhost:6379

LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret

# No JWT_SECRET here on purpose: nothing reads one. Sessions are opaque
# SHA-256 tokens stored in Postgres (docs/architecture/deploy.md). An unused
# secret in an example file is worse than a missing one — an operator sets it,
# assumes sessions are stateless JWTs, and reasons about revocation wrongly.
APP_ENV=development

# Native-update advertisement served at GET /mobile/version (sideloaded APK).
# The mobile app compares its own runtimeVersion against these and prompts a
# reinstall when it is behind. All optional locally — the defaults below apply.
# MOBILE_LATEST_RUNTIME  newest shipped runtimeVersion (app.json). Default 1.3.0
# MOBILE_APK_URL         stable public APK link. Default api.getdemli.com/dl/…
# MOBILE_MIN_RUNTIME     optional forced-update floor (unset ⇒ advisory only)
# NOTE: production does NOT read these two from an env file — both are pinned in
# docker-compose.prod.yml so a native release is one commit + deploy.
MOBILE_LATEST_RUNTIME=1.8.0
MOBILE_APK_URL=https://api.getdemli.com/dl/mobile/demli.apk
# MOBILE_MIN_RUNTIME=1.0.0

# --- Error monitoring (desktop, optional) -----------------------------------
# Sentry DSN for the desktop app. BUILD-TIME only: it is baked into the main
# bundle by `pnpm package:win` / `package:mac` (a packaged Electron app has no
# runtime env of its own).
#
# LEAVE EMPTY = SENTRY COMPLETELY OFF. No init, no state, no network request.
# That is the default and it is deliberate — there is no account yet.
# Paste the DSN from Sentry (Settings -> Projects -> <project> -> Client Keys)
# to turn it on. It is a public key, not a secret, but keep the real value in a
# local .env / CI secret rather than in Git.
#   SENTRY_DSN=https://<publicKey>@o000000.ingest.de.sentry.io/0000000
# Details + privacy posture: docs/architecture/crash-reporting.md
SENTRY_DSN=
