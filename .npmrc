# Flat node_modules (npm/yarn-style). Required for the Expo/React Native native
# build (apps/mobile): Metro/Gradle's JS bundling resolves babel-preset-expo,
# metro, and expo-modules-autolinking from a hoisted layout — pnpm's default
# isolated symlink store breaks `createBundleReleaseJsAndAssets` with
# "Cannot find module 'babel-preset-expo'". Applies to the whole workspace;
# desktop/api/realtime builds are unaffected by hoisting.
node-linker=hoisted
